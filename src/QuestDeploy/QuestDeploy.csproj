<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.10.2</Version>
    <AssemblyName>QuestDeploy</AssemblyName>
    <ApplicationIcon>Resources\QuestDeploy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Resources\QuestDeploy.ico" />
    <None Remove="Resources\QuestDeploy.png" />
    <Resource Include="Resources\QuestDeploy.ico" />
    <Content Include="Resources\QuestDeploy.png" Link="branding\scrcpy.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
