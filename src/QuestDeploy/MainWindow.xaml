<Window x:Class="QuestDeploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuestDeploy"
        Title="Quest Classroom Deploy" Height="800" Width="1180" MinHeight="700" MinWidth="980"
        Background="#F1F4F6" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="Ink" Color="#15202B" />
        <SolidColorBrush x:Key="Muted" Color="#4B5B6B" />
        <SolidColorBrush x:Key="Line" Color="#D5DDE4" />
        <SolidColorBrush x:Key="Field" Color="#C5CFD8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Dock" Color="#F7F9FA" />
        <SolidColorBrush x:Key="Accent" Color="#0F766E" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E6F4F1" />
        <SolidColorBrush x:Key="AccentInk" Color="#134E48" />

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="BorderBrush" Value="{StaticResource Field}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="BorderBrush" Value="{StaticResource Field}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Dock}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceNameBox" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="2,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F4F6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="#DDE4EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Headset list: no default selection chrome, cards handle their own state -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HeadsetTemplate">
            <Border x:Name="Card" Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                    BorderBrush="#DCE3E9" BorderThickness="1.5" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              IsEnabled="{Binding IsConnected}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Column="1" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="#EAF0F4" />
                        <Border Width="30" Height="19" CornerRadius="9" BorderThickness="2"
                                BorderBrush="#3B4C5C" Background="#EAF0F4"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Width="15" Height="9" CornerRadius="4.5" BorderThickness="1.5"
                                BorderBrush="#3B4C5C" Background="White"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="13" Height="13" Stroke="White" StrokeThickness="2"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                    </Grid>

                    <Grid Grid.Column="2" Margin="2,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" VerticalAlignment="Center"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                            </Border>
                            <TextBox Style="{StaticResource DeviceNameBox}"
                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Click the name to rename this headset"
                                     LostKeyboardFocus="OnDeviceNameChanged" />
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Wi-Fi MAC" Style="{StaticResource LabelText}" Margin="0,2,9,0" />
                            <TextBlock Text="{Binding MacDisplay}" FontFamily="Consolas" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{Binding DeviceFacts}" Margin="0,3,0,0"
                                   Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="{Binding Detail}" Margin="0,4,0,0"
                                   Foreground="#8A4B00" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="104">
                        <Button Content="Set up Wi-Fi" Style="{StaticResource SmallPrimaryButton}"
                                Click="OnEnableWifiForDevice" CommandParameter="{Binding}"
                                Visibility="{Binding CanEnableWifi, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Identify" Style="{StaticResource SmallButton}"
                                Click="OnIdentifyDevice" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Card" Property="Background" Value="#F3FAF8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.72" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" BorderBrush="#D5DDE4" BorderThickness="0,0,0,1" Padding="14,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Restart" Click="OnRestartApplication" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitApplication" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="About Quest Classroom Deploy" Click="OnShowAbout" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reconnect Wi-Fi" Click="OnReconnectKnown" />
                <Button Style="{StaticResource PrimaryButton}" Content="Refresh headsets" Click="OnRefresh" Margin="0" />
            </StackPanel>
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                    Background="{StaticResource Accent}" Margin="0,0,14,0" VerticalAlignment="Center">
                <Grid Width="24" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="White" BorderThickness="2" />
                    <Border Width="9" Height="5" CornerRadius="2.5" BorderBrush="White" BorderThickness="1.5"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1" />
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Quest Classroom Deploy" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="AdbStatusText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" MinWidth="560" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Headsets -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="18,16,18,12">
                        <CheckBox x:Name="SelectAllBox" DockPanel.Dock="Right" Content="Select all ready"
                                  FontWeight="SemiBold" Checked="OnSelectAll" Unchecked="OnSelectAll" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Headsets" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DeviceSummaryText" Text="Checking connections..." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Margin="18,0,18,12" Padding="12,10" CornerRadius="8" Background="{StaticResource AccentSoft}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" x:Name="ReadyCountText" Text="0 ready"
                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Foreground="{StaticResource AccentInk}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold" Text="New headset? " />
                                <Run Text="Plug in USB, choose Always allow inside the headset, then press Set up Wi-Fi on its card." />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="DevicesGrid" ItemsSource="{Binding Devices}"
                                 ItemTemplate="{StaticResource HeadsetTemplate}"
                                 ItemContainerStyle="{StaticResource PlainItem}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="18,0,18,8" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="80" Height="60" Margin="0,0,0,12">
                                <Border Width="76" Height="46" CornerRadius="22" BorderThickness="4"
                                        BorderBrush="#9BA9B5" Background="#EEF2F4" />
                                <Border Width="38" Height="24" CornerRadius="11" BorderThickness="3"
                                        BorderBrush="#9BA9B5" Background="White" />
                            </Grid>
                            <TextBlock Text="No headsets connected" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                            <TextBlock Text="Connect a USB headset, then press Refresh headsets."
                                       Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Deployment -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,16,18,10">
                        <TextBlock Text="Deployment" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Choose an app, class files, or both." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,4,18,14">

                            <!-- 1 App -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource StepTitle}">
                                        <Run Text="App installer" /><Run Text=" · optional" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ApkPathBox" IsReadOnly="True" FontSize="12.5" />
                                        <Button Grid.Column="1" Content="Choose APK" Click="OnBrowseApk" Margin="8,0,0,0" FontSize="12.5" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 2 Files -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource QuietButton}" Click="OnClearContent" />
                                        <TextBlock Style="{StaticResource StepTitle}" VerticalAlignment="Center">
                                            <Run Text="Videos, audio and files" /><Run Text=" · optional" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="10" Background="{StaticResource Dock}"
                                            BorderBrush="#AEBBC7" BorderThickness="1.5">
                                        <StackPanel>
                                            <ListBox x:Name="ContentList" ItemsSource="{Binding DeploymentItems}"
                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                     MinHeight="56" MaxHeight="112" FontSize="12.5"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <Button Content="+ Add files" Click="OnAddFiles" Style="{StaticResource SmallButton}" Margin="0,0,4,0" />
                                                <Button Content="+ Add folder" Click="OnAddFolder" Style="{StaticResource SmallButton}" Margin="4,0,0,0" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 3 Destination -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Destination on each headset" Style="{StaticResource StepTitle}" />
                                    <TextBox x:Name="TargetFolderBox" Text="/sdcard/Download/CourseMedia"
                                             FontFamily="Consolas" Margin="0,8,0,5" />
                                    <TextBlock Text="Created automatically if it doesn't exist." Style="{StaticResource LabelText}" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <!-- Options -->
                            <StackPanel Margin="36,0,0,0">
                                <Border BorderBrush="#E3E9EE" BorderThickness="0,1,0,0" Margin="0,0,0,14" />
                                <CheckBox x:Name="ReplaceExistingBox" Content="Reinstall over the existing app" IsChecked="True" Margin="0,0,0,10" />
                                <CheckBox x:Name="LaunchAfterInstallBox" Content="Open the app when finished"
                                          Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged" Margin="0,0,0,8" />
                                <TextBox x:Name="PackageBox" IsEnabled="False" MinHeight="34" FontFamily="Consolas" FontSize="12.5"
                                         ToolTip="Android package name, for example com.school.physicslab"
                                         Margin="28,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Deploy dock -->
                    <Border Grid.Row="2" Background="{StaticResource Dock}" BorderBrush="#E3E9EE" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12" Padding="18,14,18,16">
                        <StackPanel>
                            <Button x:Name="DeployButton" Style="{StaticResource PrimaryButton}"
                                    Content="Deploy to selected headsets" Click="OnDeploy"
                                    MinHeight="46" FontSize="14.5" Margin="0" />
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock x:Name="ActivityStateText" Text="Ready" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="ActivityCountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" />
                            </DockPanel>
                            <ProgressBar x:Name="DeploymentProgress" Height="6" Margin="0,7,0,7" Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="ActivityDetailText" Text="Select connected headsets and deployment content."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="FooterStatusText" Margin="2,12,0,0"
                   Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
