<Window x:Class="QuestDeploy.CastOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cast headset" Height="330" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F1F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#15202B" />
        <SolidColorBrush x:Key="Muted" Color="#4B5B6B" />
        <SolidColorBrush x:Key="Line" Color="#D5DDE4" />
        <SolidColorBrush x:Key="Accent" Color="#0F766E" />
        <Style x:Key="ViewOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1.5" CornerRadius="8" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="OptionBorder" Property="Background" Value="#E6F4F1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C5CFD8" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,17">
            <StackPanel>
                <TextBlock Text="Choose cast view" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="DeviceText" Margin="0,3,0,0" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="22,22,12,22">
            <RadioButton x:Name="LeftEyeOption" GroupName="CastView" IsChecked="True" Style="{StaticResource ViewOption}">
                <StackPanel>
                    <Grid Height="54" Margin="0,0,0,9">
                        <Border Height="38" CornerRadius="18" BorderBrush="#627482" BorderThickness="2" Background="#EAF0F4" />
                        <Border Width="48" Height="28" HorizontalAlignment="Left" Margin="10,0,0,0"
                                CornerRadius="13" Background="{StaticResource Accent}" />
                    </Grid>
                    <TextBlock Text="Left eye" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="RightEyeOption" GroupName="CastView" Style="{StaticResource ViewOption}">
                <StackPanel>
                    <Grid Height="54" Margin="0,0,0,9">
                        <Border Height="38" CornerRadius="18" BorderBrush="#627482" BorderThickness="2" Background="#EAF0F4" />
                        <Border Width="48" Height="28" HorizontalAlignment="Right" Margin="0,0,10,0"
                                CornerRadius="13" Background="{StaticResource Accent}" />
                    </Grid>
                    <TextBlock Text="Right eye" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="BothEyesOption" GroupName="CastView" Style="{StaticResource ViewOption}">
                <StackPanel>
                    <Grid Height="54" Margin="0,0,0,9">
                        <Border Height="38" CornerRadius="18" BorderBrush="#627482" BorderThickness="2" Background="#EAF0F4" />
                        <Grid Margin="10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="9" Background="{StaticResource Accent}" />
                            <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource Accent}" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="Both eyes" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button Content="Start casting" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnStartCasting" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
