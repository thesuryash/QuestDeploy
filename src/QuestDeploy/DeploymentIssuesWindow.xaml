<Window x:Class="QuestDeploy.DeploymentIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deployment issues" Height="690" Width="860" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="#F1F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#15202B" />
        <SolidColorBrush x:Key="Muted" Color="#4B5B6B" />
        <SolidColorBrush x:Key="Line" Color="#D5DDE4" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C5CFD8" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,19">
            <StackPanel>
                <TextBlock Text="Deployment needs attention" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Issues}" BorderThickness="0" Background="Transparent"
                 Padding="22,18" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#FDECEC" CornerRadius="10" Padding="9,3">
                                    <TextBlock Text="{Binding ErrorCode}" Foreground="#9B1C1C" FontFamily="Consolas" FontSize="11.5" />
                                </Border>
                                <TextBlock Text="{Binding HeadsetName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}" Margin="0,10,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RecoverySteps}" Margin="0,9,0,0" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" LineHeight="20" />
                            <Expander Header="Raw ADB diagnostic" Margin="0,12,0,0" Foreground="{StaticResource Muted}">
                                <TextBox Text="{Binding RawDetails}" Margin="0,8,0,0" Padding="10" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" MinHeight="70" MaxHeight="170" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
