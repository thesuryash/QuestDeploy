<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>QuestDeploy-Setup</AssemblyName>
    <Version>0.10.3</Version>
    <ApplicationIcon>..\QuestDeploy\Resources\QuestDeploy.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\QuestDeploy-release.zip"
                      LogicalName="QuestDeploy-release.zip"
                      Condition="Exists('Payload\QuestDeploy-release.zip')" />
  </ItemGroup>
</Project>
